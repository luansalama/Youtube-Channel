+def _handle_alive(handle: Any) -> bool:
+    if handle is None:
+        return False
+    poll = getattr(handle, "poll", None)
+    if callable(poll):
+        try:
+            return poll() is None
+        except Exception:
+            return False
+    alive = getattr(handle, "is_alive", None)
+    if callable(alive):
+        try:
+            return bool(alive())
+        except Exception:
+            return False
+    return False
