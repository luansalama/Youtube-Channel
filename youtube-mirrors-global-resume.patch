+                        download_verified(root, slug, primary_vod_id, video_id, log=log)
+            if log:
+                log.write(f"assignment {number}/{total}: youtube={video_id} resume=completed -> skip all {len(eligible_ids)} VODs\n")
+                log.flush()
+            continue
