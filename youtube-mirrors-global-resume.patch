+            pair_results = dict(assignment.get("pair_results") or {})
+            evaluated_ids = {str(x) for x in (assignment.get("evaluated_vod_ids") or [])}
+
+            for vod in eligible_vods:
+                current_vod_id = str(vod.get("vod_id") or "")
