rnal aftermath\",\"27\",\"24\",\"FC-AF (-7,2.3,-9), 60-degree FOV\",\"Static through flash and portal resolution\",\"Camera begins only after black; no protagonist viewpoint.\"\n\"PATH-026\",\"S13-001\",\"Omniscient environmental dolly\",\"12\",\"24\",\"OM-C (-8,3,-10), 52-degree FOV\",\"OM-C (-2,2.2,-4), portal centre held\",\"Smooth and head-bob-free; begins in protagonist-free aftermath.\"\n\"PATH-027\",\"S13-002\",\"Live portal or matched 3D card path\",\"10\",\"24\",\"R4 source side (0,2,-2)\",\"R0 destination side (0,2,5)\",\"Pass matching seam; preserve frame-edge occlusion.\"\n\"PATH-028\",\"S13-003\",\"Blender or modular in-game path; tool unselected\",\"13\",\"24\",\"Vertical module Y0 looking upward\",\"Vertical module Y18 at R0 surface light\",\"Matched dissolves are acceptable; no literal clipping or consciousness implication.\"\n\"PATH-029\",\"S13-005\",\"Locked underground reveal\",\"5\",\"24\",\"P03 reveal reference camera\",\"Static frame with R1 rainy destination\",\"Portal sound exists underground only.\""},{"path":".studio/internal/production/asset-register.csv","content":"asset_id,asset,type,source_or_owner,licence,version,needed_for,status,notes\n\"SW-001\",\"Minecraft Java Edition\",\"game\",\"Mojang Studios\",\"Proprietary\",\"1.20.1 provisional\",\"Base production and world generation\",\"research_candidate\",\"No installation or exact Java runtime is evidenced.\"\n\"SW-002\",\"Fabric Loader\",\"mod_loader\",\"FabricMC\",\"Apache-2.0 recorded in supplied context\",\"Unpinned\",\"Loading the candidate mod stack\",\"dependency_pending\",\"Pin only after official exact dependency review.\"\n\"DEP-001\",\"Fabric API\",\"library\",\"FabricMC\",\"Apache-2.0 recorded in supplied context\",\"Final pin absent; Dimensional Weather states 0.92.2+1.20.1 minimum\",\"Candidate Fabric dependencies\",\"dependency_pending\",\"Record exact artefact and hash after acquisition.\"\n\"DEP-002\",\"iCommon API\",\"library\",\"Isaiah\",\"LGPL-3.0 AND Unlicense recor