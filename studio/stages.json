[
  {
    "name": "direction",
    "label": "Direction",
    "approval_gate": "direction_lock",
    "user_document": "01-direction/direction.md",
    "assistant_focus": "Develop the smallest strong concept, decide whether research is needed, and make the viewer promise explicit.",
    "human_focus": "Choose the creative direction worth making.",
    "requirements": [
      {
        "path": "01-direction/direction.md",
        "kind": "text",
        "min_chars": 900,
        "label": "direction document"
      },
      {
        "path": ".studio/internal/direction/idea-score.json",
        "kind": "json",
        "required_keys": [
          "premise",
          "viewer_promise",
          "expected_pleasure",
          "hook",
          "dramatic_engine",
          "thematic_question",
          "minecraft_causality",
          "climactic_choice",
          "ending",
          "final_state",
          "scope",
          "score",
          "decision",
          "research_mode",
          "research_reason"
        ],
        "label": "internal direction scorecard"
      }
    ],
    "validators": [
      "conditional_research"
    ]
  },
  {
    "name": "story",
    "label": "Story",
